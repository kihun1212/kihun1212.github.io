---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="A little about the author of this blog.">
  <article class="space-y-5">
    <h1 class="text-3xl font-bold tracking-tight">About</h1>
    <p class="leading-7 text-zinc-600 dark:text-zinc-400">
      I'm Alex, a curious person who enjoys learning, making things, and sharing useful notes.
    </p>
    <p class="leading-7 text-zinc-600 dark:text-zinc-400">
      This is a small personal blog. Replace this introduction with a few words about yourself.
    </p>
  </article>
</BaseLayout>
